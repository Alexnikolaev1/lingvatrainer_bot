# Обязательно
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# AI — бесплатные тиры (нужен хотя бы один)
GEMINI_API_KEY=your_gemini_key          # aistudio.google.com — без карты
GROQ_API_KEY=your_groq_key              # console.groq.com — без карты

# Модели (проверено на июнь 2026)
GEMINI_MODEL=gemini-2.5-flash-lite      # НЕ gemini-2.0-flash — отключена!
GROQ_LLM_MODEL=llama-3.1-8b-instant     # fallback: 14400 req/day free

# Railway (автоматически)
# RAILWAY_PUBLIC_DOMAIN=xxx.up.railway.app
# PORT=8080

# Опционально
NEWSAPI_KEY=
WEBHOOK_URL=
DB_PATH=/data/lingva.db                 # Railway: примонтируй volume на /data
TTS_VOICE=en-US-AriaNeural
